      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_audio": {
          "type": "boolean"
        },
        "include_video": {
          "type": "boolean"
        },
        "auto_publish": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
