          "type": "boolean"
        },
        "publish_to_youtube": {
          "type": "boolean"
        },
        "export_social_pack": {
          "type": "boolean"
        },
        "export_newsletter_pack": {
          "type": "boolean"
        },
        "context": {
          "type": "string"
        },
        "export_payhip_pack": {
          "type": "boolean"
        },
        "generate_images": {
          "type": "boolean"
        },
        "image_style": {
          "type": "string"
        },
        "num_images": {
          "type": "integer"
        },
        "generate_thumbnails": {
          "type": "boolean"
        },
        "generate_product_covers": {
          "type": "boolean"
        },
        "generate_social_visuals": {
          "type": "boolean"
        },
        "include_thread_bomber": {
          "type": "boolean"
        },
        "include_short_form_pack": {
          "type": "boolean"
        }
      }
    },
    "example_constraints": {
      "include_audio": true,
      "include_video": true,
      "auto_publish": false,
      "dry_run": true,
      "publish_to_gumroad": true,
      "publish_to_youtube": true,
      "export_social_pack": true,
      "export_newsletter_pack": true,
      "export_payhip_pack": true,
      "generate_images": false,
      "image_style": "cinematic",
      "num_images": 3,
      "generate_thumbnails": false,
      "generate_product_covers": false,
      "generate_social_visuals": false,
      "include_thread_bomber": false,
      "include_short_form_pack": false
