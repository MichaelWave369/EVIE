  "vault_to_lesson_pack": {
    "description": "Build a coherent lesson pack from vault/topic context: podcast script, slides, infographic, study assets, with optional audio/video media.",
    "tags": [
      "lesson",
      "media",
      "notebooklm",
      "workflow"
    ],
    "notes": "Optional steps are controlled by include_audio/include_video flags and degrade to partial success when media dependencies are unavailable.",
    "input_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_audio": {
          "type": "boolean",
          "description": "Run audio_generator after podcast script."
        },
        "include_video": {
          "type": "boolean",
          "description": "Run video_generator after presentation/infographic/audio."
        },
        "context": {
          "type": "string",
          "description": "Optional retrieved vault context."
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional prior artifacts to include."
        }
      }
    },
    "example_constraints": {
      "include_audio": false,
      "include_video": false,
      "style": "educational",
      "mode": "flashcards"
    },
    "steps": [
      {
        "module": "podcast_script_generator"
      },
      {
        "module": "presentation_generator"
      },
      {
        "module": "infographic_generator"
      },
      {
        "module": "study_module"
      },
      {
        "module": "audio_generator",
        "optional": true,
        "when_constraint": "include_audio"
      },
      {
        "module": "video_generator",
        "optional": true,
        "when_constraint": "include_video"
      }
    ]
  },
