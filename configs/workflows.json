        "module": "thread_bomber",
        "optional": true,
        "when_constraint": "include_thread_bomber"
      },
      {
        "module": "short_form_pack",
        "optional": true,
        "when_constraint": "include_short_form_pack"
      },
      {
        "module": "payhip_packager"
      },
      {
        "module": "image_generator_v2",
        "optional": true,
        "when_constraint": "generate_images"
      },
      {
        "module": "thumbnail_generator",
        "optional": true,
        "when_constraint": "generate_thumbnails"
      },
      {
        "module": "product_cover_generator",
        "optional": true,
        "when_constraint": "generate_product_covers"
      },
      {
        "module": "social_visual_generator",
        "optional": true,
        "when_constraint": "generate_social_visuals"
      },
      {
        "module": "content_exporter"
      },
      {
        "module": "publish_controller"
      },
      {
        "module": "gumroad_publisher",
        "optional": true,
        "when_constraint": "publish_to_gumroad"
      },
      {
        "module": "youtube_publisher",
        "optional": true,
        "when_constraint": "publish_to_youtube"
      }
    ]
  },
