          }
        },
        "create_predictions": {
          "type": "boolean"
        },
        "emails": {
          "type": "integer"
        }
      }
    },
    "example_constraints": {
      "keywords": [
        "ai education",
        "creator economy"
      ],
      "create_predictions": true,
      "emails": 5
    },
    "steps": [
      {
        "module": "trend_surfer"
      },
      {
        "module": "prediction_tracker",
        "constraints": {
          "action": "add"
        }
      },
      {
        "module": "idea_miner"
      },
      {
        "module": "sales_page_builder"
      },
      {
        "module": "email_sequence_builder"
      },
      {
        "module": "cross_pollinator"
      }
    ]
  },
  "trend_to_money_publish": {
    "description": "Trend-aligned opportunity to product + launch-ready outputs with optional publish automation.",
    "tags": [
      "trend",
      "money",
      "publish",
      "workflow"
    ],
    "notes": "Safety-first: publish is optional and controlled via run_publish_workflow/auto_publish/dry_run flags.",
    "input_schema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_cross_pollination": {
          "type": "boolean"
        },
        "create_predictions": {
          "type": "boolean"
        },
        "include_audio": {
          "type": "boolean"
        },
        "include_video": {
          "type": "boolean"
        },
        "auto_publish": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "run_publish_workflow": {
          "type": "boolean"
        },
        "generate_images": {
          "type": "boolean"
        },
        "generate_thumbnails": {
          "type": "boolean"
        },
        "generate_product_covers": {
          "type": "boolean"
        },
        "generate_social_visuals": {
          "type": "boolean"
        },
        "include_thread_bomber": {
          "type": "boolean"
        },
        "include_short_form_pack": {
          "type": "boolean"
        }
      }
    },
    "example_constraints": {
      "keywords": [
        "ai creator tools",
        "micro products"
      ],
      "create_predictions": true,
      "include_cross_pollination": true,
      "include_audio": false,
      "include_video": false,
      "auto_publish": false,
      "dry_run": true,
      "run_publish_workflow": false,
      "generate_images": false,
      "generate_thumbnails": false,
      "generate_product_covers": false,
      "generate_social_visuals": false,
      "include_thread_bomber": false,
      "include_short_form_pack": false
    },
    "steps": [
      {
        "module": "trend_surfer"
      },
      {
        "module": "prediction_tracker",
        "optional": true,
        "when_constraint": "create_predictions",
        "constraints": {
          "action": "add",
          "source": "trend_to_money_publish"
        }
      },
      {
        "module": "idea_miner"
      },
      {
        "module": "cross_pollinator",
        "optional": true,
        "when_constraint": "include_cross_pollination"
      },
      {
        "workflow": "vault_to_money_pack"
      },
      {
        "module": "sales_page_builder"
      },
      {
        "module": "email_sequence_builder"
      },
      {
        "module": "thread_bomber",
        "optional": true,
        "when_constraint": "include_thread_bomber"
      },
      {
        "module": "short_form_pack",
        "optional": true,
        "when_constraint": "include_short_form_pack"
      },
      {
        "workflow": "vault_to_money_publish",
        "optional": true,
        "when_constraint": "run_publish_workflow"
      }
    ]
  }
