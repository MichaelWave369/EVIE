# ============================================================
# EVIE v4.0 — Configuration File
# INSTRUCTIONS: Copy this to ".env" and fill in your values.
#   cp .env.example .env
# ============================================================

# ---- API Security ----
# Change this! Used as the X-API-Key header in all API calls.
EV_API_KEY=my-secret-key-change-this
# Optional: dashboard target API base (used by hosted dashboard deployments)
# EV_API_BASE=https://your-api-host.example.com

# ============================================================
# LLM BACKEND — Choose ONE option below
# ============================================================

# OPTION A: OpenAI (recommended — no local GPU required)
# Get key at: https://platform.openai.com/api-keys
EV_LLM_BACKEND=openai
EV_OPENAI_API_KEY=sk-your-openai-key-here
EV_OPENAI_MODEL=gpt-4o-mini

# OPTION B: Anthropic Claude (premium quality)
# Get key at: https://console.anthropic.com
# EV_LLM_BACKEND=anthropic
# EV_ANTHROPIC_API_KEY=sk-ant-your-key-here
# EV_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OPTION C: Ollama (100% local, no API costs, requires Ollama installed)
# Install: https://ollama.com → then run: ollama pull llama3.1
# EV_LLM_BACKEND=ollama
# EV_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EV_OLLAMA_CHAT_MODEL=llama3.1

# OPTIONAL: ElevenLabs TTS (used by audio_generator)
# EV_ELEVENLABS_API_KEY=your-elevenlabs-key
# EV_VOICE_HOST_A=adam
# EV_VOICE_HOST_B=rachel

# OPTIONAL: Publish integrations (used by vault_to_money_publish)
# Newsletter/social export packs do not require API credentials.
# Gumroad product creation (live publish path)
# EV_GUMROAD_ACCESS_TOKEN=your-gumroad-access-token
# YouTube upload (OAuth bearer token with YouTube upload scope)
# EV_YOUTUBE_ACCESS_TOKEN=your-youtube-oauth-access-token


# OPTIONAL: Local Visual FX bridge (manual EXE handoff orchestration)
# Start bridge: python tools/visual_fx_bridge.py
# EV_VISUAL_FX_BRIDGE_URL=http://127.0.0.1:18888
# EV_VISUAL_FX_BRIDGE_DIR=./data/visual_fx_bridge
# EV_VISUAL_FX_BRIDGE_HOST=127.0.0.1
# EV_VISUAL_FX_BRIDGE_PORT=18888
# EV_VISUAL_FX_AUTO_COMPLETE_ON_OUTPUT=false
# EV_VISUAL_FX_OUTPUT_EXTS=.png,.jpg,.jpeg,.webp,.svg,.pdf,.json,.txt,.md
# Optional convenience launch paths (manual completion still required)
# EV_VISION_FX_EXE=C:\Path\To\VisionFX2.exe
# EV_RENDER_FX_EXE=C:\Path\To\RenderFX1.exe
# EV_VECTOR_FX_EXE=C:\Path\To\VectorFX1.exe

# OPTIONAL: AI image generation
# Local-first ComfyUI endpoint for image_generator_v2
# EV_COMFYUI_URL=http://127.0.0.1:8188
# Optional OpenAI image fallback model
# EV_OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================================
# EMBEDDINGS BACKEND — Choose ONE option below
# ============================================================

# OPTION A: Hash (default — no API needed, works offline, less semantic)
EV_EMBED_BACKEND=hash

# OPTION B: OpenAI embeddings (best quality, uses your OpenAI key above)
# EV_EMBED_BACKEND=openai

# OPTION C: Ollama embeddings (local, requires: ollama pull nomic-embed-text)
# EV_EMBED_BACKEND=ollama

# ============================================================
# DATA STORAGE (usually no need to change)
# ============================================================
EV_DATA_DIR=./data
EV_DB_PATH=./data/embervault.db

# ============================================================
# OPTIONAL FEATURES
# ============================================================

# Background automation (runs modules on a schedule)
EV_WORKER_AUTORUN=false
# EV_WORKER_INTERVAL_SECONDS=300

# Swarm mode (multi-agent orchestration)
EV_SWARM_ENABLED=true
