# Copy to .env, then replace this with a unique randomly generated long key.
# Never use the placeholder value: the protected EVIE API refuses it.
EV_API_KEY=replace-with-a-unique-random-secret
# To run completely local with Ollama, choose an installed Ollama model:
EV_LLM_BACKEND=ollama
EV_OLLAMA_BASE_URL=http://127.0.0.1:11434
EV_OLLAMA_CHAT_MODEL=llama3.1
EV_EMBED_BACKEND=hash
EV_DATA_DIR=./data
EV_DB_PATH=./data/embervault.db
EV_WORKER_AUTORUN=false
# Configure publishing/inference credentials privately only if needed.
