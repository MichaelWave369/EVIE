# R13 local review bundles (do not commit generated review files)
review-receipt.json
workflow-preflight.json

# R16 signed local lease / review usage observation
*.lease.json
lease-consumption.json
*lease-ledger*.sqlite

# R17 Docker capsule is temporary; no local container/image metadata in repository
*.docker-observation.json
